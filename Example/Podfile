source 'https://cdn.cocoapods.org/'
platform :ios, '15.0'
use_frameworks!

project 'MYKit.xcodeproj'
target 'MYKit_Example' do
  pod 'MYKit', :path => '../'
  pod 'SDWebImage', '~> 5.21'
  pod 'MJRefresh', '~> 3.7'
  target 'MYKit_Tests' do
    inherit! :search_paths
  end
end

# The example has the same minimum OS as MYKit, including dependency targets.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      # SafeKit catches Objective-C exceptions; unwind must release ARC locals.
      if target.name == 'MYKit'
        config.build_settings['CLANG_ENABLE_OBJC_ARC_EXCEPTIONS'] = 'YES'
      end
    end
  end
end
